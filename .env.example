# Copy to .env at repository root. Never commit .env.
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Non-commercial capstone only. Enable API in Google Cloud and restrict this backend key.
LYNVERIS_GOOGLE_API_KEY=
# Empty means explicitly unavailable; never a placeholder model.
LYNVERIS_MODEL_DIRECTORY=
LYNVERIS_CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]
LYNVERIS_RATE_LIMIT_PER_MINUTE=30
# Local non-Docker development only (Compose overrides to PostgreSQL).
LYNVERIS_DATABASE_URL=sqlite:///./lynveris.db
