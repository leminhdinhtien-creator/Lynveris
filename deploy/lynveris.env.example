LYNVERIS_DEPLOYMENT_MODE=release
LYNVERIS_DATABASE_URL=
LYNVERIS_AUTO_CREATE_DEV_DATABASE=false
LYNVERIS_RETENTION_CLEANUP_ENABLED=true
LYNVERIS_MODEL_DIRECTORY=/var/lib/lynveris/model
LYNVERIS_CORS_ORIGINS=[]
LYNVERIS_RATE_LIMIT_PER_MINUTE=30
# Academic, non-commercial deployment. Enable the licensed provider(s) in use.
LYNVERIS_THREAT_PROVIDER=combined
LYNVERIS_OPENPHISH_ACADEMIC_USE=true
LYNVERIS_GOOGLE_API_KEY=
